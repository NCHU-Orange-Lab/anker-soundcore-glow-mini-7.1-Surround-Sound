<!-- One card per connected Glow Mini (with TWS, only each pair's main speaker reaches the PC). -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        CornerRadius="18" BorderBrush="#30463F" BorderThickness="1" Padding="24,20,24,16" Margin="0,0,0,16">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C3633"/><GradientStop Color="#151D29" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Viewbox Width="58" Height="64" Margin="0,2,18,0" VerticalAlignment="Top" IsHitTestVisible="False">
        <Canvas Width="160" Height="175">
          <Path Data="M 111,38 C 159,5 168,94 127,95" Stroke="#354B52" StrokeThickness="6"/>
          <Border Canvas.Left="25" Canvas.Top="32" Width="104" Height="119" CornerRadius="23,23,32,32" BorderBrush="#4B6068" BorderThickness="1">
            <Border.Background><LinearGradientBrush><GradientStop Color="#3B4B55"/><GradientStop Color="#19232C" Offset="1"/></LinearGradientBrush></Border.Background>
          </Border>
          <Ellipse Canvas.Left="25" Canvas.Top="18" Width="104" Height="42" Fill="#1F2A33" Stroke="#5C7078" StrokeThickness="1"/>
          <Ellipse Canvas.Left="33" Canvas.Top="23" Width="88" Height="29" Fill="#162128" Stroke="#3E545D"/>
          <Path Data="M 37,126 C 52,144 102,145 117,126" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Stroke><LinearGradientBrush><GradientStop Color="#7E8FFF"/><GradientStop Color="#6CE8D2" Offset="0.5"/><GradientStop Color="#E0B4FF" Offset="1"/></LinearGradientBrush></Path.Stroke>
          </Path>
        </Canvas>
      </Viewbox>
      <StackPanel Grid.Column="1">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="#6CE8B0" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ConnectionText" Text="已連線 · 音訊可用" Foreground="#8FEBCE" FontSize="12" VerticalAlignment="Center"/>
          <Border x:Name="RoleTag" Background="#21332F" BorderBrush="#31554C" BorderThickness="1" CornerRadius="6" Padding="7,1" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="RoleText" Foreground="#91F1DD" FontSize="11"/>
          </Border>
        </StackPanel>
        <TextBlock x:Name="DeviceTitle" Text="soundcore Glow Mini" FontWeight="SemiBold" FontSize="22" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="AddressText" Foreground="#94ACA9" FontFamily="Consolas" FontSize="12" Margin="0,7,0,0"/>
        <TextBlock x:Name="DeviceIdentity" Text="韌體與序號：等待裝置回覆" Foreground="#94ACA9" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="BatteryText" Text="正在讀取電量…" Foreground="#A0EEDC" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="BatteryUpdated" Foreground="#8B9BAD" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,0,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="VolumeNumber" Text="—" FontSize="38" FontWeight="Light"/>
          <TextBlock Text="%" Foreground="{StaticResource Muted}" Margin="5,19,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VolumeCaption" Text="喇叭音量" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="VolumeDown" Content="−" Padding="0" FontSize="22" Height="34" ToolTip="降低 5%"/>
      <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Margin="14,0" IsMoveToPointEnabled="True"/>
      <Button x:Name="VolumeUp" Grid.Column="2" Content="+" Padding="0" FontSize="20" Height="34" ToolTip="提高 5%"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
        <Button x:Name="Preset25" Content="25%" Padding="12,7" Margin="0,0,6,0"/>
        <Button x:Name="Preset50" Content="50%" Padding="12,7" Margin="0,0,6,0"/>
        <Button x:Name="Preset75" Content="75%" Padding="12,7"/>
      </StackPanel>
      <Button x:Name="Mute" Grid.Column="4" Content="靜音" Background="#273A39" BorderBrush="#395954" Foreground="#A0EEDC" Padding="18,7" Margin="12,0,0,0" MinWidth="86"/>
    </Grid>
    <Border BorderBrush="#2E4A45" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
      <StackPanel>
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="PartyCast" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="PartyCastState" Text="狀態未取得" Foreground="#A0EEDC" FontSize="13" Margin="12,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PartyCastOn" Content="開啟" IsEnabled="False" Background="#294C43" BorderBrush="#416D60" Padding="16,6" Margin="0,0,6,0" FontSize="12"/>
            <Button x:Name="PartyCastOff" Content="關閉" IsEnabled="False" Padding="16,6" FontSize="12"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PartyCastHint" Text="設定後會向這顆喇叭確認結果。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PartyCastPeers" Foreground="#A4B8C3" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   ToolTip="曾與這顆一起 PartyCast 的喇叭，上次直接連接電腦時讀到的資料，不是群組中的即時狀態。"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Border>
