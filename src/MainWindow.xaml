<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundcore Desk" Width="1080" Height="920" MinWidth="940" MinHeight="740"
        Background="#0D1016" Foreground="#EDF3FA" FontFamily="Segoe UI, Microsoft JhengHei UI"
        FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#121720" BorderBrush="#222B37" BorderThickness="0,0,1,0">
      <Grid Margin="24,32,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Background="#6CE8D2" CornerRadius="12" Width="42" Height="42" HorizontalAlignment="Left" Margin="0,0,0,18">
            <TextBlock Text="≈" FontSize="35" Foreground="#102C2B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0"/>
          </Border>
          <TextBlock Text="soundcore" FontSize="25" FontWeight="Bold"/>
          <TextBlock Text="DESK / 桌面控制中心" Foreground="{StaticResource Muted}" FontSize="10" Margin="1,7,0,34"/>
          <!-- Page switcher: each page stays alive, so surround / the sync test keep playing on other pages. -->
          <Button x:Name="NavHome" Style="{StaticResource Nav}" AutomationProperties.Name="我的喇叭">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Grid.Column="1" Text="我的喇叭"/>
            </Grid>
          </Button>
          <Button x:Name="NavSurround" Style="{StaticResource Nav}" Margin="0,6,0,0" AutomationProperties.Name="4 聲道環繞" ToolTip="把多聲道聲音拆成前、後兩組喇叭播放">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Grid.Column="1" Text="4 聲道環繞"/>
              <TextBlock x:Name="NavSurroundLive" Grid.Column="2" Text="播放中" Foreground="#6CE8B0" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Button x:Name="NavSync" Style="{StaticResource Nav}" Margin="0,6,0,0" AutomationProperties.Name="環繞同步測試" ToolTip="同時對兩顆喇叭播放滴答聲，測試能否對齊與長時間漂移">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Grid.Column="1" Text="環繞同步測試"/>
              <TextBlock x:Name="NavSyncLive" Grid.Column="2" Text="播放中" Foreground="#6CE8B0" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Button>
          <TextBlock Text="連上聲音，留在當下。" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,20,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Button x:Name="BluetoothSettings" Content="藍牙設定  ↗" Margin="0,0,0,10"/>
          <Button x:Name="SoundSettings" Content="音效設定  ↗" Background="Transparent"/>
          <TextBlock Text="獨立桌面工具 · v1.13" Foreground="#667789" FontSize="10" Margin="2,22,0,0"/>
          <TextBlock Text="非 Anker 官方應用程式" Foreground="#667789" FontSize="10" Margin="2,6,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
    <Border x:Name="SurroundPage" Visibility="Collapsed"/>
    <Border x:Name="SyncPage" Visibility="Collapsed"/>
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="34,28,34,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <StackPanel Margin="0,0,150,0">
          <TextBlock Text="聲音，由你掌握。" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock x:Name="HomeSubtitle" Text="正在讀取 Windows 音訊與藍牙狀態…" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="Refresh" Content="↻  重新整理" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"/>
      </Grid>
      <!-- One card per connected Glow Mini (SpeakerCard.xaml), each with its own volume. -->
      <StackPanel Grid.Row="1">
        <Border x:Name="NoSpeakers" Background="#171E28" BorderBrush="#293341" BorderThickness="1" CornerRadius="16" Padding="24,20" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="尚未連線" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="開啟喇叭，並在 Windows 藍牙設定中連線。TWS 配對時，每組只有連接電腦的主喇叭會出現在這裡。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="SpeakerList"/>
      </StackPanel>
      <Grid Grid.Row="3" Margin="0,15,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="準備就緒" FontSize="11" Foreground="#8194A7" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="ToTray" Grid.Column="1" Content="收至通知區域 ↘" Background="Transparent" Padding="10,6" FontSize="11"/>
      </Grid>
    </Grid>
    </ScrollViewer>
    </Grid>
  </Grid>
</Window>
