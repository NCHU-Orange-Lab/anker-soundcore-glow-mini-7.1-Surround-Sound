<!-- A page inside the main window (left nav「環繞同步測試」); fonts and colours inherit from it. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="34,28,34,22">
      <TextBlock Text="環繞同步測試" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="21"
                 Text="讓兩顆喇叭各自用藍牙連電腦（先退出 TWS 和 PartyCast），模擬環繞的前、後兩組。開始後兩顆會同時播放滴答聲：A 是高音、B 是低音，每 4 下有 1 下較大聲。"/>

      <Border Background="#171E28" BorderBrush="#293341" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,20,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="1 · 選擇兩顆喇叭" FontSize="16" FontWeight="SemiBold"/>
            <Button x:Name="RefreshDevices" Content="↻  重新整理" HorizontalAlignment="Right" Background="Transparent" Padding="10,6" FontSize="12"/>
          </Grid>
          <TextBlock Text="A · 前方（高音滴答）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,6"/>
          <ComboBox x:Name="DeviceA" AutomationProperties.Name="喇叭 A"/>
          <TextBlock Text="B · 後方（低音滴答）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,6"/>
          <ComboBox x:Name="DeviceB" AutomationProperties.Name="喇叭 B"/>
          <TextBlock x:Name="DeviceHint" TextWrapping="Wrap" Foreground="#E6C890" FontSize="12" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="StartTest" Content="▶  開始播放" Background="#294C43" BorderBrush="#416D60" Margin="0,0,8,0"/>
            <Button x:Name="StopTest" Content="■  停止" IsEnabled="False"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="#172A2B" BorderBrush="#31534D" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="2 · 對齊兩顆" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                     Text="調到高音和低音聽起來合成同一下。先聽到哪一顆，就讓哪一顆晚一點播：先聽到高音（A）往左拉，先聽到低音（B）往右拉。"/>
          <Grid Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <TextBlock x:Name="OffsetNumber" Text="0" FontSize="38" FontWeight="Light"/>
              <TextBlock Text="ms" Foreground="{StaticResource Muted}" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock x:Name="OffsetMeaning" Text="兩顆都不延遲" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#A0EEDC" Margin="0,0,0,8"/>
          </Grid>
          <Slider x:Name="OffsetSlider" Minimum="-300" Maximum="300" SmallChange="1" LargeChange="10" Value="0" IsMoveToPointEnabled="True" AutomationProperties.Name="A 與 B 的延遲差"/>
          <Grid Margin="0,2,0,0">
            <TextBlock Text="← 延後 A" Foreground="{StaticResource Muted}" FontSize="11"/>
            <TextBlock Text="延後 B →" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="OffsetMinus10" Content="−10" Padding="14,7" Margin="0,0,6,6"/>
            <Button x:Name="OffsetMinus1" Content="−1" Padding="14,7" Margin="0,0,6,6"/>
            <Button x:Name="OffsetZero" Content="歸零" Padding="14,7" Margin="0,0,6,6" Background="Transparent"/>
            <Button x:Name="OffsetPlus1" Content="+1" Padding="14,7" Margin="0,0,6,6"/>
            <Button x:Name="OffsetPlus10" Content="+10" Padding="14,7" Margin="0,0,6,6"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <CheckBox x:Name="PlayA" Content="播放 A（高音）" IsChecked="True" Margin="0,0,22,0"/>
            <CheckBox x:Name="PlayB" Content="播放 B（低音）" IsChecked="True"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"
                     Text="只開一顆可確認哪個聲音來自哪一顆喇叭。"/>
        </StackPanel>
      </Border>

      <Border Background="#171E28" BorderBrush="#293341" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="3 · 長時間漂移" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" LineHeight="19"
                     Text="對齊後按「記錄」。之後每隔幾分鐘聽一次；如果不再合成一聲，就重新對齊再記錄。最後一筆和第一筆的差，就是兩顆喇叭之間實際的漂移量。建議至少測 10–15 分鐘。"/>
          <Grid Margin="0,14,0,0">
            <TextBlock x:Name="Elapsed" Text="尚未開始" FontSize="22" FontWeight="Light"/>
            <Button x:Name="RecordMark" Content="記錄目前對齊值" HorizontalAlignment="Right" IsEnabled="False" Background="#294C43" BorderBrush="#416D60"/>
          </Grid>
          <TextBlock x:Name="WindowsDrift" Text="Windows 端相對漂移：—" Foreground="#A4B8C3" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                     ToolTip="由 Windows 音訊時鐘測得，只反映電腦送出端；喇叭端的漂移只能用耳朵（上方記錄）判斷。"/>
          <TextBlock x:Name="DriftSummary" Text="" Foreground="#A0EEDC" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="Marks" Text="尚無紀錄" Foreground="#A4B8C3" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="TestStatus" Text="準備就緒" Foreground="#8194A7" FontSize="12" Margin="2,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
